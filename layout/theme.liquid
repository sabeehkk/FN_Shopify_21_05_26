<script>
  document.querySelectorAll('.swatch').forEach(function(swatch) {
    swatch.addEventListener('click', function() {
      var variantId = this.getAttribute('data-variant-id');
      var newImage = this.getAttribute('data-image');

      console.log("Swatch clicked for variant ID:", variantId); // Debugging
      console.log("New image URL:", newImage); // Debugging
      
      // Update the selected variant in the hidden ProductSelect
      var variantSelect = document.querySelector(`#ProductSelect option[value="${variantId}"]`);
      
      if (variantSelect) {
        variantSelect.selected = true;
        document.querySelector('#ProductSelect').dispatchEvent(new Event('change'));
        console.log("Variant selected:", variantId); // Debugging
      } else {
        console.log("Variant not found for ID:", variantId); // Debugging
      }

      // Update the main product image with the new variant's image
      var mainImage = document.querySelector('.theme-img'); // Ensure this selector is correct
      if (mainImage && newImage) {
        mainImage.src = newImage;
        console.log("Main image updated:", newImage); // Debugging
      } else {
        console.log("Main image element or new image URL is missing."); // Debugging
      }
    });
  });
</script>

