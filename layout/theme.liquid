    {% comment %} cart popup {% endcomment %}
     <div id="add-to-cart-toast" style="display: none;" class="cart-toast">
  <span id="toast-message">Item added to cart!</span>
</div>
  <style>
      .cart-toast {
      position: fixed;
      top: 70px; /* Adjust as needed to be just below cart icon */
      right: 20px;
      background-color: #323232;
      color: white;
      padding: 12px 18px;
      border-radius: 6px;
      font-size: 14px;
      z-index: 10000;
      opacity: 0;
      transition: opacity 0.3s ease-in-out;
    }

    .cart-toast.show {
      display: block;
      opacity: 1;
    }
  </style>
  <script>
  function showCartToast(message) {
    const toast = document.getElementById('add-to-cart-toast');
    const toastMessage = document.getElementById('toast-message');
    
    toastMessage.textContent = message || 'Item added to cart!';
    toast.classList.add('show');

    setTimeout(() => {
      toast.classList.remove('show');
    }, 3000); // hide after 3 seconds
  }


</script>

