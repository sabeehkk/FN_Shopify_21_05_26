{% liquid
  assign hero_image = section.settings.hero_image
  assign hero_image_secondary = section.settings.hero_image_secondary
  assign hero_image_tertiary = section.settings.hero_image_tertiary
  assign lifestyle_image = section.settings.lifestyle_image
%}

<section class="premium-about premium-about--{{ section.id }}" data-premium-about>
  <div class="premium-about__hero">
    <div class="premium-about__inner">
      <div class="premium-about__hero-copy premium-about__reveal">
        {% if section.settings.eyebrow != blank %}
          <p class="premium-about__eyebrow">{{ section.settings.eyebrow }}</p>
        {% endif %}
        {% if section.settings.heading != blank %}
          <h1 class="premium-about__heading text-link-animated">{{ section.settings.heading }}</h1>
        {% endif %}
        {% if section.settings.hero_text != blank %}
          <div class="premium-about__lede rte">{{ section.settings.hero_text }}</div>
        {% endif %}
        <div class="premium-about__actions">
          {% if section.settings.primary_button_label != blank %}
            <a class="premium-about__button premium-about__button--primary" href="{{ section.settings.primary_button_link | default: routes.root_url }}">
              {{ section.settings.primary_button_label }}
            </a>
          {% endif %}
          {% if section.settings.secondary_button_label != blank %}
            <a class="premium-about__button premium-about__button--ghost" href="{{ section.settings.secondary_button_link | default: routes.root_url }}">
              {{ section.settings.secondary_button_label }}
            </a>
          {% endif %}
        </div>
      </div>

      <div class="premium-about__image-stack premium-about__reveal" data-premium-parallax>
        <div class="premium-about__line premium-about__line--one"></div>
        <div class="premium-about__line premium-about__line--two"></div>
        <figure class="premium-about__photo premium-about__photo--main">
          {% if hero_image != blank %}
            {% render 'responsive-image' with hero_image, alt: hero_image.alt, sizes: '(min-width: 990px) 38vw, 92vw', loading: 'eager', allow_stretch: true %}
          {% else %}
            <img src="https://images.unsplash.com/photo-1517836357463-d25dfeac3438?auto=format&fit=crop&w=1100&q=80" alt="Athlete training with weights" width="1100" height="1341" loading="eager">
          {% endif %}
        </figure>
        <figure class="premium-about__photo premium-about__photo--small">
          {% if hero_image_secondary != blank %}
            {% render 'responsive-image' with hero_image_secondary, alt: hero_image_secondary.alt, sizes: '(min-width: 990px) 18vw, 48vw', loading: 'lazy', allow_stretch: true %}
          {% else %}
            <img src="https://images.unsplash.com/photo-1599058917212-d750089bc07e?auto=format&fit=crop&w=800&q=80" alt="Runner tying training shoes" width="800" height="690" loading="lazy">
          {% endif %}
        </figure>
        <figure class="premium-about__photo premium-about__photo--wide">
          {% if hero_image_tertiary != blank %}
            {% render 'responsive-image' with hero_image_tertiary, alt: hero_image_tertiary.alt, sizes: '(min-width: 990px) 24vw, 58vw', loading: 'lazy', allow_stretch: true %}
          {% else %}
            <img src="https://images.unsplash.com/photo-1534438327276-14e5300c3a48?auto=format&fit=crop&w=900&q=80" alt="Fitness apparel inside a training gym" width="900" height="621" loading="lazy">
          {% endif %}
        </figure>
      </div>
    </div>
  </div>

  <div class="premium-about__mission">
    <div class="premium-about__inner premium-about__mission-grid">
      <figure class="premium-about__lifestyle premium-about__reveal" data-premium-parallax>
        {% if lifestyle_image != blank %}
          {% render 'responsive-image' with lifestyle_image, alt: lifestyle_image.alt, sizes: '(min-width: 990px) 46vw, 92vw', loading: 'lazy', allow_stretch: true %}
        {% else %}
          <img src="https://images.unsplash.com/photo-1549060279-7e168fcee0c2?auto=format&fit=crop&w=1200&q=80" alt="Athletes training together in premium activewear" width="1200" height="968" loading="lazy">
        {% endif %}
      </figure>
      <div class="premium-about__mission-copy">
        <div class="premium-about__reveal">
          <p class="premium-about__eyebrow">{{ section.settings.mission_eyebrow }}</p>
          <h2 class="text-link-animated">{{ section.settings.mission_heading }}</h2>
          <div class="rte">{{ section.settings.mission_text }}</div>
        </div>
        <div class="premium-about__value premium-about__reveal">
          <h3 class="text-link-animated">{{ section.settings.vision_heading }}</h3>
          <div class="rte">{{ section.settings.vision_text }}</div>
        </div>
      </div>
    </div>
  </div>

</section>

<style>
  .premium-about--{{ section.id }} {
    --about-bg: {{ section.settings.background_color }};
    --about-surface: {{ section.settings.surface_color }};
    --about-text: {{ section.settings.text_color }};
    --about-muted: {{ section.settings.muted_text_color }};
    --about-accent: {{ section.settings.accent_color }};
    --about-accent-2: {{ section.settings.secondary_accent_color }};
    background: var(--about-bg);
    color: var(--about-text);
    overflow: hidden;
  }

  .premium-about--{{ section.id }} * {
    box-sizing: border-box;
  }

  .premium-about--{{ section.id }} .premium-about__inner {
    width: min(1180px, calc(100% - 40px));
    margin: 0 auto;
  }

  .premium-about--{{ section.id }} .premium-about__hero {
    position: relative;
    min-height: 760px;
    padding: clamp(72px, 8vw, 128px) 0 clamp(54px, 7vw, 96px);
    background:
      radial-gradient(circle at 82% 18%, rgba(205, 255, 75, 0.18), transparent 30%),
      linear-gradient(135deg, #0d0f10 0%, #151515 48%, #f5efe3 48.2%, #f5efe3 100%);
  }

  .premium-about--{{ section.id }} .premium-about__hero .premium-about__inner {
    display: grid;
    grid-template-columns: minmax(0, 0.9fr) minmax(420px, 1fr);
    gap: clamp(34px, 6vw, 80px);
    align-items: center;
  }

  .premium-about--{{ section.id }} .premium-about__eyebrow {
    margin: 0 0 14px;
    color: var(--about-accent);
    font-size: 12px;
    font-weight: 800;
    letter-spacing: 0.14em;
    line-height: 1.2;
    text-transform: uppercase;
  }

  .premium-about--{{ section.id }} h1,
  .premium-about--{{ section.id }} h2,
  .premium-about--{{ section.id }} h3,
  .premium-about--{{ section.id }} p {
    color: inherit;
  }

  .premium-about--{{ section.id }} h1,
  .premium-about--{{ section.id }} h2,
  .premium-about--{{ section.id }} h3 {
    margin: 0;
  }

  .premium-about--{{ section.id }} .premium-about__heading,
  .premium-about--{{ section.id }} .premium-about__mission-copy h2,
  .premium-about--{{ section.id }} .premium-about__value h3 {
    font-family: var(--header-font-stack);
    font-weight: var(--header-font-weight);
    font-style: var(--header-font-style);
    font-size: var(--h2-size);
    line-height: var(--heading-line-height);
    letter-spacing: var(--heading-spacing);
    text-transform: var(--heading-font-case);
  }

  .premium-about--{{ section.id }} .premium-about__heading {
    max-width: 680px;
    color: #ffffff;
  }

  .premium-about--{{ section.id }} .premium-about__lede {
    max-width: 560px;
    margin-top: 22px;
    color: rgba(255, 255, 255, 0.76);
    font-size: clamp(16px, 1.45vw, 19px);
    line-height: 1.7;
  }

  .premium-about--{{ section.id }} .premium-about__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin-top: 32px;
  }

  .premium-about--{{ section.id }} .premium-about__button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 48px;
    padding: 14px 24px;
    border-radius: 6px;
    border: 1px solid transparent;
    font-size: 12px;
    font-weight: 900;
    line-height: 1;
    text-decoration: none;
    text-transform: uppercase;
    transition: transform 180ms ease, background-color 180ms ease, border-color 180ms ease, color 180ms ease;
  }

  .premium-about--{{ section.id }} .premium-about__button:hover {
    transform: translateY(-2px);
  }

  .premium-about--{{ section.id }} .premium-about__button--primary {
    background: var(--about-accent);
    color: #101010;
    box-shadow: 0 18px 38px rgba(205, 255, 75, 0.22);
  }

  .premium-about--{{ section.id }} .premium-about__button--ghost {
    border-color: rgba(255, 255, 255, 0.28);
    color: #ffffff;
    background: rgba(255, 255, 255, 0.06);
    backdrop-filter: blur(12px);
  }

  .premium-about--{{ section.id }} .premium-about__image-stack {
    position: relative;
    min-height: 560px;
  }

  .premium-about--{{ section.id }} .premium-about__photo {
    position: absolute;
    margin: 0;
    overflow: hidden;
    border: 1px solid rgba(255, 255, 255, 0.22);
    border-radius: 8px;
    background: rgba(255, 255, 255, 0.12);
    box-shadow: 0 28px 80px rgba(0, 0, 0, 0.28);
    transform: translate3d(0, var(--parallax-y, 0), 0);
    transition: transform 400ms ease, box-shadow 220ms ease;
  }

  .premium-about--{{ section.id }} .premium-about__photo:hover {
    box-shadow: 0 34px 95px rgba(0, 0, 0, 0.36);
  }

  .premium-about--{{ section.id }} .premium-about__photo img,
  .premium-about--{{ section.id }} .premium-about__photo .responsive-image-wrapper,
  .premium-about--{{ section.id }} .premium-about__photo .theme-img,
  .premium-about--{{ section.id }} .premium-about__lifestyle img,
  .premium-about--{{ section.id }} .premium-about__lifestyle .responsive-image-wrapper,
  .premium-about--{{ section.id }} .premium-about__lifestyle .theme-img {
    width: 100%;
    height: 100%;
    display: block;
    max-width: none !important;
    max-height: none !important;
    object-fit: cover;
  }

  .premium-about--{{ section.id }} .premium-about__photo--main {
    width: 62%;
    aspect-ratio: 0.82;
    right: 3%;
    top: 24px;
  }

  .premium-about--{{ section.id }} .premium-about__photo--small {
    width: 44%;
    aspect-ratio: 1.16;
    left: 0;
    top: 98px;
  }

  .premium-about--{{ section.id }} .premium-about__photo--wide {
    width: 48%;
    aspect-ratio: 1.45;
    left: 12%;
    bottom: 28px;
  }

  .premium-about--{{ section.id }} .premium-about__line {
    position: absolute;
    z-index: 0;
    height: 1px;
    background: linear-gradient(90deg, transparent, rgba(0, 0, 0, 0.36), transparent);
    transform-origin: center;
  }

  .premium-about--{{ section.id }} .premium-about__line--one {
    width: 86%;
    right: -10%;
    top: 21%;
    transform: rotate(-44deg);
  }

  .premium-about--{{ section.id }} .premium-about__line--two {
    width: 78%;
    left: 4%;
    bottom: 20%;
    transform: rotate(-31deg);
  }

  .premium-about--{{ section.id }} .premium-about__mission-grid {
    display: grid;
    grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.1fr);
    gap: clamp(28px, 6vw, 84px);
    align-items: center;
  }

  .premium-about--{{ section.id }} .premium-about__panel {
    padding: clamp(26px, 4vw, 46px);
    border: 1px solid rgba(20, 20, 20, 0.1);
    border-radius: 8px;
    background: rgba(255, 255, 255, 0.54);
    box-shadow: 0 18px 50px rgba(20, 20, 20, 0.08);
  }

  .premium-about--{{ section.id }} .rte {
    color: var(--about-muted);
    font-size: 16px;
    line-height: 1.75;
  }

  .premium-about--{{ section.id }} .premium-about__mission {
    padding: clamp(72px, 10vw, 130px) 0;
    background:
      linear-gradient(135deg, rgba(205, 255, 75, 0.12), transparent 36%),
      #101112;
    color: #ffffff;
  }

  .premium-about--{{ section.id }} .premium-about__lifestyle {
    aspect-ratio: 1.24;
    margin: 0;
    overflow: hidden;
    border-radius: 8px;
    box-shadow: 0 30px 90px rgba(0, 0, 0, 0.36);
    transform: translate3d(0, var(--parallax-y, 0), 0);
  }

  .premium-about--{{ section.id }} .premium-about__mission-copy {
    display: grid;
    gap: 34px;
  }

  .premium-about--{{ section.id }} .premium-about__value {
    padding: 28px;
    border: 1px solid rgba(255, 255, 255, 0.12);
    border-radius: 8px;
    background: rgba(255, 255, 255, 0.07);
    box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.08);
    backdrop-filter: blur(14px);
  }

  .premium-about--{{ section.id }} .premium-about__value h3 {
    margin-bottom: 14px;
  }

  .premium-about--{{ section.id }} .premium-about__reveal {
    opacity: 0;
    transform: translateY(26px);
    transition: opacity 620ms ease, transform 620ms ease;
  }

  .premium-about--{{ section.id }} .premium-about__reveal.is-visible {
    opacity: 1;
    transform: translateY(0);
  }

  @media (max-width: 989px) {
    .premium-about--{{ section.id }} .premium-about__hero {
      min-height: 0;
      background:
        radial-gradient(circle at 78% 12%, rgba(205, 255, 75, 0.18), transparent 30%),
        linear-gradient(180deg, #0d0f10 0%, #151515 56%, #f5efe3 56.2%, #f5efe3 100%);
    }

    .premium-about--{{ section.id }} .premium-about__hero .premium-about__inner,
    .premium-about--{{ section.id }} .premium-about__mission-grid {
      grid-template-columns: 1fr;
    }

    .premium-about--{{ section.id }} .premium-about__image-stack {
      min-height: 500px;
    }

  }

  @media (max-width: 640px) {
    .premium-about--{{ section.id }} .premium-about__inner {
      width: min(100% - 28px, 1180px);
    }

    .premium-about--{{ section.id }} .premium-about__actions,
    .premium-about--{{ section.id }} .premium-about__button {
      width: 100%;
    }

    .premium-about--{{ section.id }} .premium-about__image-stack {
      min-height: 390px;
    }

    .premium-about--{{ section.id }} .premium-about__photo--main {
      width: 72%;
      right: 0;
      top: 4px;
    }

    .premium-about--{{ section.id }} .premium-about__photo--small {
      width: 50%;
      top: 74px;
    }

    .premium-about--{{ section.id }} .premium-about__photo--wide {
      width: 62%;
      left: 4%;
      bottom: 6px;
    }

  }

  @media (prefers-reduced-motion: reduce) {
    .premium-about--{{ section.id }} .premium-about__button,
    .premium-about--{{ section.id }} .premium-about__photo,
    .premium-about--{{ section.id }} .premium-about__reveal {
      transition: none;
    }

    .premium-about--{{ section.id }} .premium-about__reveal {
      opacity: 1;
      transform: none;
    }
  }
</style>

<script>
  (function() {
    var section = document.querySelector('.premium-about--{{ section.id }}');
    if (!section || section.dataset.aboutInit === 'true') return;
    section.dataset.aboutInit = 'true';

    var reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    var revealItems = section.querySelectorAll('.premium-about__reveal');

    if ('IntersectionObserver' in window && !reducedMotion) {
      var observer = new IntersectionObserver(function(entries) {
        entries.forEach(function(entry) {
          if (entry.isIntersecting) {
            entry.target.classList.add('is-visible');
            observer.unobserve(entry.target);
          }
        });
      }, { threshold: 0.16 });

      revealItems.forEach(function(item) {
        observer.observe(item);
      });
    } else {
      revealItems.forEach(function(item) {
        item.classList.add('is-visible');
      });
    }

    if (!reducedMotion) {
      var parallaxItems = section.querySelectorAll('[data-premium-parallax]');
      var ticking = false;

      function updateParallax() {
        parallaxItems.forEach(function(item) {
          var rect = item.getBoundingClientRect();
          var progress = (window.innerHeight - rect.top) / (window.innerHeight + rect.height);
          var clamped = Math.max(0, Math.min(1, progress));
          var offset = (clamped - 0.5) * 22;
          item.style.setProperty('--parallax-y', offset.toFixed(2) + 'px');
        });
        ticking = false;
      }

      window.addEventListener('scroll', function() {
        if (!ticking) {
          window.requestAnimationFrame(updateParallax);
          ticking = true;
        }
      }, { passive: true });

      updateParallax();
    }
  })();
</script>

