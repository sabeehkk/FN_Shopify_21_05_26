{% liquid
  assign market_label = section.settings.market_label | default: localization.market.name
  assign heading = section.settings.heading | default: 'COMING SOON'
  assign eyebrow = section.settings.eyebrow | default: 'Funky Nation'
  assign message = section.settings.message
%}

<section
  class="fn-coming-soon fn-coming-soon--{{ section.id }}"
  data-wetheme-section-type="coming-soon-region"
  data-wetheme-section-id="{{ section.id }}"
  style="--padding-section-top: {{ section.settings.section_padding_top }}px; --padding-section-bottom: {{ section.settings.section_padding_bottom }}px;"
>
  <div class="fn-coming-soon__inner">
    <div class="fn-coming-soon__media" aria-hidden="true">
      <div class="fn-coming-soon__media-grid">
        <span></span>
        <span></span>
        <span></span>
        <span></span>
      </div>
      <div class="fn-coming-soon__monogram">FN</div>
      <div class="fn-coming-soon__rings fn-coming-soon__rings--left"></div>
      <div class="fn-coming-soon__rings fn-coming-soon__rings--right"></div>
      <div class="fn-coming-soon__join">Join the movement</div>
    </div>

    <div class="fn-coming-soon__content">
      <p class="fn-coming-soon__eyebrow">{{ eyebrow | escape }}</p>
      {% if section.settings.flag_image != blank %}
        <div class="fn-coming-soon__flag">
          {% assign flag_alt = section.settings.flag_image.alt | default: market_label %}
          {% render 'responsive-image' with section.settings.flag_image, alt: flag_alt | escape, sizes: '180px' %}
        </div>
      {% endif %}
      <div class="fn-coming-soon__market">{{ market_label | escape }}</div>
      <h1 class="fn-coming-soon__heading">{{ heading | escape }}</h1>

      {% if message != blank %}
        <div class="fn-coming-soon__message rte">{{ message }}</div>
      {% endif %}

      <div class="fn-coming-soon__steps" aria-label="Launch progress">
        <div class="fn-coming-soon__step">
          <span class="fn-coming-soon__arrow"></span>
          <span>We are</span>
        </div>
        <div class="fn-coming-soon__step">
          <span class="fn-coming-soon__arrow"></span>
          <span>Levelling</span>
        </div>
        <div class="fn-coming-soon__step">
          <span class="fn-coming-soon__arrow"></span>
          <span>Up</span>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .fn-coming-soon--{{ section.id }} {
    padding-top: var(--padding-section-top);
    padding-bottom: var(--padding-section-bottom);
    background:
      linear-gradient(135deg, rgba(230, 136, 25, 0.12), rgba(255, 255, 255, 0) 34%),
      linear-gradient(180deg, #ffffff 0%, #f6f4f1 100%);
    color: #111111;
    overflow: hidden;
  }

  .fn-coming-soon--{{ section.id }} .fn-coming-soon__flag {
    width: clamp(96px, 10vw, 140px);
    aspect-ratio: 4 / 3;
    margin: 0 0 18px;
    border: 1px solid rgba(255, 255, 255, 0.2);
    background: rgba(255, 255, 255, 0.08);
    box-shadow: 0 14px 30px rgba(0, 0, 0, 0.22);
    overflow: hidden;
  }

  .fn-coming-soon--{{ section.id }} .fn-coming-soon__flag img {
    width: 100%;
    height: 100%;
    display: block;
    object-fit: cover;
  }

  .fn-coming-soon--{{ section.id }} .fn-coming-soon__flag .responsive-image-wrapper {
    width: 100%;
    height: 100%;
  }

  .fn-coming-soon--{{ section.id }} .fn-coming-soon__inner {
    width: min(1180px, calc(100% - 32px));
    min-height: clamp(560px, 74vh, 760px);
    margin: 0 auto;
    display: grid;
    grid-template-columns: minmax(0, 1.05fr) minmax(360px, 0.95fr);
    align-items: stretch;
    background: #181614;
    box-shadow: 0 24px 70px rgba(0, 0, 0, 0.16);
    position: relative;
    isolation: isolate;
  }

  .fn-coming-soon--{{ section.id }} .fn-coming-soon__inner::before {
    content: "";
    position: absolute;
    inset: 0;
    background:
      linear-gradient(118deg, rgba(230, 136, 25, 0.26), rgba(230, 136, 25, 0) 38%),
      radial-gradient(circle at 90% 12%, rgba(255, 255, 255, 0.12), rgba(255, 255, 255, 0) 28%);
    pointer-events: none;
    z-index: 1;
  }

  .fn-coming-soon--{{ section.id }} .fn-coming-soon__media {
    min-height: 100%;
    position: relative;
    background:
      linear-gradient(rgba(20, 18, 16, 0.22), rgba(20, 18, 16, 0.5)),
      repeating-linear-gradient(90deg, rgba(255, 255, 255, 0.09) 0 1px, transparent 1px 118px),
      linear-gradient(140deg, #4b2720 0%, #241f1c 46%, #0f0f0e 100%);
    clip-path: polygon(0 0, 100% 0, 86% 100%, 0 100%);
    overflow: hidden;
  }

  .fn-coming-soon--{{ section.id }} .fn-coming-soon__media::before,
  .fn-coming-soon--{{ section.id }} .fn-coming-soon__media::after {
    content: "";
    position: absolute;
    background: rgba(255, 255, 255, 0.86);
    box-shadow: 0 0 28px rgba(255, 255, 255, 0.18);
  }

  .fn-coming-soon--{{ section.id }} .fn-coming-soon__media::before {
    width: 72%;
    height: 12px;
    left: 8%;
    top: 20%;
    transform: rotate(-7deg);
  }

  .fn-coming-soon--{{ section.id }} .fn-coming-soon__media::after {
    width: 12px;
    height: 68%;
    left: 24%;
    top: 11%;
    transform: rotate(7deg);
  }

  .fn-coming-soon--{{ section.id }} .fn-coming-soon__media-grid {
    position: absolute;
    inset: 0;
  }

  .fn-coming-soon--{{ section.id }} .fn-coming-soon__media-grid span {
    position: absolute;
    display: block;
    border: 2px solid rgba(255, 255, 255, 0.28);
    background: rgba(255, 255, 255, 0.08);
  }

  .fn-coming-soon--{{ section.id }} .fn-coming-soon__media-grid span:nth-child(1) {
    width: 120px;
    height: 220px;
    left: 10%;
    bottom: 13%;
    transform: skewX(-8deg);
  }

  .fn-coming-soon--{{ section.id }} .fn-coming-soon__media-grid span:nth-child(2) {
    width: 150px;
    height: 150px;
    right: 20%;
    top: 17%;
    border-radius: 50%;
  }

  .fn-coming-soon--{{ section.id }} .fn-coming-soon__media-grid span:nth-child(3) {
    width: 84px;
    height: 240px;
    right: 26%;
    bottom: 10%;
    transform: rotate(12deg);
    background: rgba(230, 136, 25, 0.18);
    border-color: rgba(230, 136, 25, 0.42);
  }

  .fn-coming-soon--{{ section.id }} .fn-coming-soon__media-grid span:nth-child(4) {
    width: 220px;
    height: 58px;
    left: 22%;
    bottom: 21%;
    transform: rotate(-12deg);
    background: rgba(0, 0, 0, 0.3);
  }

  .fn-coming-soon--{{ section.id }} .fn-coming-soon__monogram {
    position: absolute;
    left: 9%;
    top: 34%;
    color: #ffffff;
    font-size: clamp(84px, 11vw, 160px);
    font-weight: 900;
    letter-spacing: 0;
    line-height: 0.86;
    opacity: 0.94;
    text-shadow: 0 16px 36px rgba(0, 0, 0, 0.32);
  }

  .fn-coming-soon--{{ section.id }} .fn-coming-soon__rings {
    position: absolute;
    width: 82px;
    height: 82px;
    border: 12px solid rgba(255, 255, 255, 0.78);
    border-radius: 50%;
    filter: drop-shadow(0 12px 24px rgba(0, 0, 0, 0.28));
  }

  .fn-coming-soon--{{ section.id }} .fn-coming-soon__rings--left {
    left: 54%;
    top: 10%;
  }

  .fn-coming-soon--{{ section.id }} .fn-coming-soon__rings--right {
    left: 69%;
    top: 15%;
    transform: scale(0.78);
  }

  .fn-coming-soon--{{ section.id }} .fn-coming-soon__join {
    position: absolute;
    left: 50%;
    bottom: 12%;
    transform: translateX(-50%);
    min-width: 245px;
    padding: 14px 26px;
    background: #ffffff;
    color: #111111;
    font-size: 14px;
    font-weight: 900;
    letter-spacing: 0.08em;
    line-height: 1;
    text-align: center;
    text-transform: uppercase;
    clip-path: polygon(7% 0, 93% 0, 100% 50%, 93% 100%, 7% 100%, 0 50%);
  }

  .fn-coming-soon--{{ section.id }} .fn-coming-soon__content {
    position: relative;
    z-index: 2;
    display: flex;
    flex-direction: column;
    justify-content: center;
    padding: clamp(36px, 6vw, 76px);
    background:
      linear-gradient(150deg, rgba(255, 255, 255, 0.04), rgba(255, 255, 255, 0)),
      #201d1a;
    color: #ffffff;
  }

  .fn-coming-soon--{{ section.id }} .fn-coming-soon__content::before {
    content: "";
    position: absolute;
    inset: 0 auto 0 -24%;
    width: 48%;
    background: #6b5045;
    clip-path: polygon(0 0, 100% 50%, 0 100%);
    opacity: 0.78;
    z-index: -1;
  }

  .fn-coming-soon--{{ section.id }} .fn-coming-soon__eyebrow {
    margin: 0 0 12px;
    color: #e68819;
    font-size: 13px;
    font-weight: 800;
    letter-spacing: 0.16em;
    text-transform: uppercase;
  }

  .fn-coming-soon--{{ section.id }} .fn-coming-soon__market {
    width: fit-content;
    margin-bottom: 20px;
    padding: 9px 14px;
    border: 1px solid rgba(255, 255, 255, 0.22);
    background: rgba(255, 255, 255, 0.08);
    color: #ffffff;
    font-size: 14px;
    font-weight: 800;
    text-transform: uppercase;
  }

  .fn-coming-soon--{{ section.id }} .fn-coming-soon__heading {
    max-width: 680px;
    margin: 0;
    color: #ffffff;
    font-size: clamp(58px, 8vw, 118px);
    font-weight: 900;
    letter-spacing: 0;
    line-height: 0.86;
    text-transform: uppercase;
  }

  .fn-coming-soon--{{ section.id }} .fn-coming-soon__message {
    max-width: 560px;
    margin-top: 26px;
    color: rgba(255, 255, 255, 0.78);
    font-size: clamp(15px, 1.4vw, 18px);
    line-height: 1.65;
  }

  .fn-coming-soon--{{ section.id }} .fn-coming-soon__message p {
    margin: 0;
  }

  .fn-coming-soon--{{ section.id }} .fn-coming-soon__steps {
    display: grid;
    gap: 14px;
    max-width: 390px;
    margin-top: clamp(34px, 5vw, 54px);
  }

  .fn-coming-soon--{{ section.id }} .fn-coming-soon__step {
    display: grid;
    grid-template-columns: 54px 1fr;
    align-items: center;
    gap: 14px;
    color: #111111;
    font-size: clamp(20px, 2.2vw, 32px);
    font-style: italic;
    font-weight: 900;
    line-height: 1;
    text-transform: uppercase;
  }

  .fn-coming-soon--{{ section.id }} .fn-coming-soon__step span:last-child {
    display: block;
    padding: 15px 24px;
    background: #f3eee7;
    clip-path: polygon(11% 0, 100% 0, 89% 100%, 0 100%);
  }

  .fn-coming-soon--{{ section.id }} .fn-coming-soon__arrow {
    width: 52px;
    height: 30px;
    background:
      radial-gradient(circle, #ffffff 0 2px, transparent 3px) 0 50% / 10px 10px,
      linear-gradient(45deg, transparent 0 43%, #ffffff 44% 56%, transparent 57%) right center / 30px 30px no-repeat;
    position: relative;
  }

  .fn-coming-soon--{{ section.id }} .fn-coming-soon__arrow::after {
    content: "";
    position: absolute;
    right: -1px;
    top: 4px;
    width: 22px;
    height: 22px;
    border-top: 9px solid #ffffff;
    border-right: 9px solid #ffffff;
    transform: rotate(45deg);
  }

  @media screen and (max-width: 900px) {
    .fn-coming-soon--{{ section.id }} .fn-coming-soon__inner {
      width: min(100% - 24px, 640px);
      min-height: 0;
      grid-template-columns: 1fr;
    }

    .fn-coming-soon--{{ section.id }} .fn-coming-soon__media {
      min-height: 320px;
      clip-path: polygon(0 0, 100% 0, 100% 86%, 50% 100%, 0 86%);
    }

    .fn-coming-soon--{{ section.id }} .fn-coming-soon__content {
      padding: 42px 24px 48px;
    }

    .fn-coming-soon--{{ section.id }} .fn-coming-soon__content::before {
      inset: -18% 0 auto 0;
      width: 100%;
      height: 34%;
      clip-path: polygon(0 0, 100% 0, 50% 100%);
    }

    .fn-coming-soon--{{ section.id }} .fn-coming-soon__heading {
      font-size: clamp(48px, 15vw, 76px);
    }

    .fn-coming-soon--{{ section.id }} .fn-coming-soon__steps {
      max-width: none;
    }
  }

  @media screen and (max-width: 520px) {
    .fn-coming-soon--{{ section.id }} .fn-coming-soon__inner {
      width: 100%;
    }

    .fn-coming-soon--{{ section.id }} .fn-coming-soon__media {
      min-height: 280px;
    }

    .fn-coming-soon--{{ section.id }} .fn-coming-soon__join {
      min-width: 210px;
      font-size: 12px;
    }

    .fn-coming-soon--{{ section.id }} .fn-coming-soon__step {
      grid-template-columns: 40px 1fr;
      gap: 10px;
      font-size: 18px;
    }

    .fn-coming-soon--{{ section.id }} .fn-coming-soon__step span:last-child {
      padding: 13px 18px;
    }

    .fn-coming-soon--{{ section.id }} .fn-coming-soon__arrow {
      width: 40px;
      transform: scale(0.82);
      transform-origin: left center;
    }
  }
</style>

{% schema %}
{
  "name": "Coming soon region",
  "class": "section--coming-soon-region",
  "settings": [
    {
      "type": "image_picker",
      "id": "flag_image",
      "label": "Flag image"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Funky Nation"
    },
    {
      "type": "text",
      "id": "market_label",
      "label": "Market label",
      "default": "UAE"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "COMING SOON"
    },
    {
      "type": "richtext",
      "id": "message",
      "label": "Message",
      "default": "<p>New energy, fresh drops, and a stronger shopping experience are on the way.</p>"
    },
    {
      "type": "range",
      "id": "section_padding_top",
      "label": "Spacing top",
      "min": 0,
      "max": 150,
      "step": 5,
      "unit": "px",
      "default": 35
    },
    {
      "type": "range",
      "id": "section_padding_bottom",
      "label": "Spacing bottom",
      "min": 0,
      "max": 150,
      "step": 5,
      "unit": "px",
      "default": 35
    }
  ],
  "presets": [
    {
      "name": "Coming soon region"
    }
  ]
}
{% endschema %}
