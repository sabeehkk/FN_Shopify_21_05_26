{{ 'section-slideshow.min.css' | asset_url | stylesheet_tag }}

<style>
  .custom-slideshow-container {
    position: relative;
    overflow: hidden;
    width: 100%;
  }

  .custom-slides-wrapper {
    display: flex;
    transition: transform 0.5s ease;
  }

  .custom-slide {
    min-width: 100%;
    box-sizing: border-box;
  }

  .custom-slide img {
    width: 100%;
    display: block;
  }

  .slideshow-arrow {
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    font-size: 36px;
    color: white;
    background: none;
    border: none;
    cursor: pointer;
    z-index: 10;
  }

  .prev-arrow {
    left: 15px;
  }

  .next-arrow {
    right: 15px;
  }

  .slideshow-dots {
    position: absolute;
    bottom: 20px;
    left: 50%;
    transform: translateX(-50%);
    display: flex;
    gap: 10px;
    z-index: 5;
  }

  .slideshow-dot {
    width: 12px;
    height: 12px;
    background-color: white;
    border-radius: 50%;
    opacity: 0.4;
    cursor: pointer;
    transition: opacity 0.3s ease;
  }

  .slideshow-dot.active {
    opacity: 1;
  }
</style>

<div class="custom-slideshow-container" data-slide-count="{{ section.blocks.size }}">
  <!-- Arrows -->
  <button class="slideshow-arrow prev-arrow" aria-label="Previous slide">&#10094;</button>
  <button class="slideshow-arrow next-arrow" aria-label="Next slide">&#10095;</button>

  <!-- Slides -->
  <div class="custom-slides-wrapper" id="customSlidesWrapper">
    {% for block in section.blocks %}
      <div class="custom-slide" {{ block.shopify_attributes }}>
        {% assign image = block.settings.image %}
        {% if image %}
         {% assign mobile_image = block.settings.mobile_image %}

          <picture>
            {% if mobile_image %}
              <source srcset="{{ mobile_image | img_url: '750x' }}" media="(max-width: 767px)">
            {% endif %}
            <img src="{{ image | img_url: '1600x' }}" alt="{{ block.settings.title | escape }}">
          </picture>

        {% endif %}
      </div>
    {% endfor %}
  </div>

  <!-- Dots -->
  <div class="slideshow-dots" id="slideshowDots">
    {% for block in section.blocks %}
      <div class="slideshow-dot {% if forloop.first %}active{% endif %}" data-index="{{ forloop.index0 }}"></div>
    {% endfor %}
  </div>
</div>

<script>
  document.addEventListener('DOMContentLoaded', function () {
    const slideshowContainers = document.querySelectorAll('.custom-slideshow-container');

    slideshowContainers.forEach((container) => {
      const wrapper = container.querySelector('.custom-slides-wrapper');
      const dotsContainer = container.querySelector('.slideshow-dots');
      const dots = dotsContainer.querySelectorAll('.slideshow-dot');
      const slides = wrapper.children;
      const totalSlides = slides.length;
      let currentSlide = 0;

      function updateSlide() {
        wrapper.style.transform = `translateX(-${currentSlide * 100}%)`;
        dots.forEach(dot => dot.classList.remove('active'));
        dots[currentSlide].classList.add('active');
      }

      // Navigation
      container.querySelector('.next-arrow').addEventListener('click', () => {
        currentSlide = (currentSlide + 1) % totalSlides;
        updateSlide();
      });

      container.querySelector('.prev-arrow').addEventListener('click', () => {
        currentSlide = (currentSlide - 1 + totalSlides) % totalSlides;
        updateSlide();
      });

      dots.forEach(dot => {
        dot.addEventListener('click', function () {
          currentSlide = parseInt(this.dataset.index);
          updateSlide();
        });
      });

      // Auto Slide every 3 seconds
      setInterval(() => {
        currentSlide = (currentSlide + 1) % totalSlides;
        updateSlide();
      }, 3000);
    });
  });
</script>



<style>
	/* Mobile */
	@media (max-width: 767px) {
		.slider-section--{{ section.id }} .slideshow--mobile-height-small {
			height: 250px;
		}
	
		.slider-section--{{ section.id }} .slideshow--mobile-height-medium {
			height: 300px;
		}
	
		.slider-section--{{ section.id }} .slideshow--mobile-height-large {
			height: 400px;
		}
	
		.slider-section--{{ section.id }} .slideshow--mobile-height-extra_large {
			height: 500px;
		}
	
		.slider-section--{{ section.id }} .slideshow--mobile-height-full_screen {
			height: 100vh;
		}
	
		.slider-section--{{ section.id }} .swiper:not(.slideshow--mobile-height-original) .responsive-image-wrapper {
			height: 100%;
			width: 100%;
		}
	}
	
	/* Desktop */
	@media (min-width: 768px) {
		.slider-section--{{ section.id }} .slideshow--desktop-height-small {
			height: 450px;
		}
	
		.slider-section--{{ section.id }} .slideshow--desktop-height-medium {
			height: 550px;
		}
	
		.slider-section--{{ section.id }} .slideshow--desktop-height-large {
			height: 650px;
		}

		.slider-section--{{ section.id }} .slideshow--desktop-height-extra_large {
			height: 750px;
		}

		.slider-section--{{ section.id }} .slideshow--desktop-height-full_screen {
			height: 100vh;
		}

		.slider-section--{{ section.id }} .swiper:not(.slideshow--desktop-height-original) .responsive-image-wrapper,
		.slider-section--{{ section.id }} .swiper:not(.slideshow--desktop-height-original) .responsive-placeholder-wrapper {
			height: 100%;
			width: 100%;
		}
	}

	.slider-section--{{ section.id }} .swiper-pagination-bullet {
		background: none;
		border: 1px solid currentColor;
		width: 11px;
		height: 11px;
		opacity: 1;
	}

	.slider-section--{{ section.id }} .swiper-pagination-bullet-active {
		background: currentColor;
	}

	{% unless section.settings.slide_navigation_style == 'arrows' and section.blocks.size > 1 %}
		.slider-section--{{ section.id }} .image--slideshow__navigation .flex-prev,
		.slider-section--{{ section.id }} .image--slideshow__navigation .flex-next{
			display:none;
		}
	{% endunless %}

	@media only screen and (max-width: 767px) {
		.slideshow-slider-container .swiper-slide .slideshow-desktop-image {
			display: none;
		}
	}
	@media only screen and (min-width: 768px) {
		.slideshow-slider-container .swiper-slide .slideshow-mobile-image {
			display: none;
		}
	}
</style>

