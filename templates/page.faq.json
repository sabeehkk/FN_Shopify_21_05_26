          "settings": {
            "question": "Can I return or exchange an item? ",
            "text": "<p>Yes! We accept returns and exchanges within 7 days of delivery, provided items are unworn, unwashed, and in original packaging with tags intact. Raise a request via our Contact Us page or WhatsApp.<br/><br/></p>"
          }
